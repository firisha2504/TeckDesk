# ==============================================================================
# TechDesk Backend Environment Configuration
# Copy this file to .env and configure values appropriate for your environment.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads

# Database (MongoDB 7.0+)
MONGODB_URI=mongodb://localhost:27017/techdesk

# Security & Authentication
# In production, replace with a secure randomly generated secret (min 32 chars)
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d
INITIAL_ADMIN_PASSWORD=your_initial_admin_password_here

# Redis & Job Queues (BullMQ persistent background SLA jobs)
# Required in production. Container networking: redis://redis:6379
REDIS_URL=redis://localhost:6379

# Development Background Job Fallback
# Set to 'true' to allow in-process interval monitoring ONLY in development mode if Redis is unavailable.
# In production (NODE_ENV=production), in-memory fallback is strictly blocked to prevent silent job loss.
ENABLE_DEV_JOB_SCHEDULER=true

# SMTP Email Delivery (Password Resets & Notifications)
# Configure an SMTP server (e.g. AWS SES, SendGrid, Mailgun, Postmark, or local MailHog/Mailpit)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TechDesk Support <no-reply@techdesk.com>
